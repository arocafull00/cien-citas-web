    "@types/react-dom": "^19.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.30",
    "prettier": "3.6.2",
    "serwist": "9.5.13",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
